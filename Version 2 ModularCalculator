# Assuming you have these basic math functions defined somewhere:
def add(a, b): return a + b
def subtract(a, b): return a - b
def multiply(a, b): return a * b
def divide(a, b): 
    if b == 0: return "Error: Division by zero."
    return a / b

try:
    first_number = float(input("Enter the first number: "))
    second_number = float(input("Enter the second number: "))
except ValueError:
    print("Invalid input. Please enter numerical values.")
    exit() # Stops the script if input is invalid

print("\nAvailable Operations:")
print("1. Add (+)")
print("2. Subtract (-)")
print("3. Multiply (*)")
print("4. Divide (/)")

choice = input("Choose an operation (1/2/3/4): ").strip()

result = None
operation_symbol = ""

if choice == "1":
    result = add(first_number, second_number)
    operation_symbol = "+"
elif choice == "2":
    result = subtract(first_number, second_number)
    operation_symbol = "-"
elif choice == "3":
    result = multiply(first_number, second_number)
    operation_symbol = "*"
elif choice == "4":
    result = divide(first_number, second_number)
    operation_symbol = "/"
else:
    print("Invalid operation choice.")
    exit()

print("\n--- Result ---")
if isinstance(result, str):
    print(result)
else:
    print(f"{first_number} {operation_symbol} {second_number} = {result}")
